{
  "name": "claude-desktop-widget",
  "productName": "Claude Widget",
  "version": "0.6.0",
  "description": "Borderless desktop widget that hosts a Claude Code terminal session.",
  "author": {
    "name": "Jacob Donajkowski",
    "email": "jdonajkowski83@gmail.com"
  },
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.0.14",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "com.jdonajkowski.claude-widget",
    "productName": "Claude Widget",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "hooks/**/*",
      "bin/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/monaco-editor/esm/**",
      "!node_modules/monaco-editor/dev/**",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Claude-Widget-Setup.${ext}"
    },
    "linux": {
      "target": [
        "pacman",
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "executableName": "claude-widget",
      "synopsis": "Desktop widget that hosts Claude Code sessions",
      "desktop": {
        "entry": {
          "StartupWMClass": "Claude Widget"
        }
      }
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst",
        "libnotify",
        "xdg-utils",
        "at-spi2-core"
      ]
    }
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "homepage": "https://github.com/jdonajkowski/claude-widget"
}
