{
  "name": "claude-desktop-widget",
  "productName": "Claude Widget",
  "version": "0.1.0",
  "description": "Borderless desktop widget that hosts a Claude Code terminal session.",
  "author": "Jacob Donajkowski",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "com.jdonajkowski.claude-widget",
    "productName": "Claude Widget",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
